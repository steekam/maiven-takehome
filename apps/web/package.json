{
  "name": "@maiven/web",
  "private": true,
  "varlock": {
    "loadPath": "../../"
  },
  "scripts": {
    "dev": "varlock run -- next dev",
    "build": "varlock run -- next build",
    "start": "varlock run -- next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/register-hooks.mjs --test tests/*.test.mjs",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include='app/api/documents/route.ts' --test-coverage-include='components/document-library/data.ts' --test-coverage-include='lib/documents/*.ts' --import ./tests/register-hooks.mjs --test tests/*.test.mjs",
    "test:query": "node --experimental-strip-types --import ./tests/register-hooks.mjs --test tests/query.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@maiven/db": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@vercel/otel": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "nuqs": "^2.10.1",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "varlock": "^1.20.0"
  }
}
