# Local app + ingest database connection.
# Use a Varlock-loaded .env.local for machine-specific values.

# @required @sensitive @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=

# Optional OpenTelemetry Collector endpoint; set it to enable telemetry.
# @optional @type=url(allowedProtocols=[http, https])
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional logs endpoint override; the URL must include /v1/logs.
# @optional @type=url(allowedProtocols=[http, https])
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# @optional
OTEL_SERVICE_NAME=maiven-web
